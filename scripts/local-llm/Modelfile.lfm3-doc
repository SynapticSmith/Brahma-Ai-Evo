FROM lfm3:1.7b

# 64K context for long documents. Sliding-window attention keeps this usable;
# expect roughly ten minutes to prefill a full 64K prompt on this CPU.
PARAMETER num_ctx 65536
PARAMETER num_thread 12
PARAMETER num_predict 4096
PARAMETER temperature 0.1
PARAMETER top_k 50
PARAMETER repeat_penalty 1.1
