FROM lfm3:1.7b

# 32K context, 12 threads. LFM3 uses sliding-window attention, so it keeps
# prefill and decode fast at long context far better than LFM2.5.
PARAMETER num_ctx 32768
PARAMETER num_thread 12
PARAMETER num_predict 4096
PARAMETER temperature 0.1
PARAMETER top_k 50
PARAMETER repeat_penalty 1.1
